/* Build config for @kerusiweb/core — pure TypeScript, no framework. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": ["src/**/*.ts"],
  /* Test-only material: the vendored conformance corpus, the example
     documents the specs are written against, and the fixture the binding
     parity specs share. Type-checked by tsconfig.spec.json, never shipped. */
  "exclude": [
    "**/*.spec.ts",
    "src/kerusi/conformance/**",
    "src/kerusi/kerusi-examples.fixture.ts",
    "src/testing/**"
  ]
}
